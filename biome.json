{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "scripts/**",
      "!**/dist",
      "!**/dist-*",
      "!**/.wxt",
      "!**/.astro",
      "!**/.output",
      "!**/.visual",
      "!**/node_modules",
      "!**/src/paraglide",
      "!**/project.inlang"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "rules": {
      "recommended": true
    }
  }
}
