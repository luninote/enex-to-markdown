<table><tr><th>Day</th><th>City</th></tr><tr><td>1</td><td>Lisbon</td></tr><tr><td>2</td><td>Porto</td></tr></table>
<div><en-media hash="f829b914fc47cfc9c0747c119c27cf1b" type="image/png"/></div>
